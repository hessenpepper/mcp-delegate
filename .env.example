# Copy to .env and fill in for whichever backend you're using.

# --- Local Ollama ---
# DELEGATE_BASE_URL=http://localhost:11434/v1
# DELEGATE_API_KEY=
# DELEGATE_MODEL=llama3.1

# --- OpenRouter ---
# DELEGATE_BASE_URL=https://openrouter.ai/api/v1
# DELEGATE_API_KEY=sk-or-...
# DELEGATE_MODEL=meta-llama/llama-3.1-70b-instruct

DELEGATE_BASE_URL=
DELEGATE_API_KEY=
DELEGATE_MODEL=

# Max delegations (delegate_task / delegate_agentic_task) allowed to run at
# once, regardless of backend. Default: 4.
# DELEGATE_MAX_CONCURRENCY=4

# Referenced by api_key_env entries in models.json (see models.json.example)
# rather than by name directly - add one env var per named backend that
# needs a key.
# OPENROUTER_API_KEY=sk-or-...
